#!/usr/bin/env python3
"""System readings for the HUD wallpaper, one JSON object per line.

Runs only while the HUD is seen (the plugin starts and stops it). Every
second it prints the sections that changed: cpu, mem and net every second,
the NPU every 2 s, processes every 3 s, the battery and network peers every
5 s, Tailscale and the Wi-Fi every 30 s, the battery's day every 5 min. The
NPU's 24 h history is read again from the journal only when the NPU served
requests since the last read (or every 10 min, as the hours roll).

Stdlib only. Nothing goes on the network but loopback calls to Lemonade,
pings to the Tailscale peers named in the config, and a read of the uptime
watcher's states (`uptimeSource`, every 15 s, from a thread of its own).
"""

import ipaddress
import json
import os
import re
import subprocess
import sys
import time
import urllib.request

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)

HOME = os.path.expanduser("~")
CONFIG = os.path.join(HOME, ".config/omarchy/hudwall.json")
DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share"), "hudwall")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state"), "hudwall")
CLK = os.sysconf("SC_CLK_TCK")
PAGE = os.sysconf("SC_PAGE_SIZE")


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return default


def config():
    try:
        with open(CONFIG) as f:
            c = json.load(f)
        return c if isinstance(c, dict) else {}
    except (OSError, ValueError):
        return {}


# ----------------------------------------------------------------- cpu

class Cpu:
    def __init__(self):
        self.prev = None
        self.temp_path = None
        for d in sorted(os.listdir("/sys/class/hwmon")):
            if read(f"/sys/class/hwmon/{d}/name").strip() in ("k10temp", "coretemp", "zenpower"):
                self.temp_path = f"/sys/class/hwmon/{d}/temp1_input"
                break

    def sample(self):
        rows = {}
        for line in read("/proc/stat").splitlines():
            if not line.startswith("cpu"):
                break
            parts = line.split()
            vals = list(map(int, parts[1:9]))
            idle = vals[3] + vals[4]
            rows[parts[0]] = (sum(vals), idle)
        out = {}
        if self.prev:
            def use(k):
                t0, i0 = self.prev.get(k, (0, 0))
                t1, i1 = rows[k]
                dt = t1 - t0
                return 0.0 if dt <= 0 else max(0.0, min(1.0, 1 - (i1 - i0) / dt))
            threads = sorted((k for k in rows if k != "cpu"), key=lambda k: int(k[3:]))
            out["threads"] = [round(use(k), 3) for k in threads]
            out["total"] = round(use("cpu"), 3)
        self.prev = rows
        freqs = []
        i = 0
        while True:
            v = read(f"/sys/devices/system/cpu/cpu{i}/cpufreq/scaling_cur_freq")
            if not v:
                break
            freqs.append(int(v))
            i += 1
        if freqs:
            out["ghz"] = round(sum(freqs) / len(freqs) / 1e6, 2)
        if self.temp_path:
            t = read(self.temp_path).strip()
            if t:
                out["temp"] = round(int(t) / 1000)
        return out


def memory():
    m = {}
    for line in read("/proc/meminfo").splitlines():
        k, _, v = line.partition(":")
        m[k] = int(v.split()[0]) * 1024 if v.split() else 0
    total = m.get("MemTotal", 0)
    free = m.get("MemFree", 0)
    cache = m.get("Cached", 0) + m.get("Buffers", 0) + m.get("SReclaimable", 0)
    used = max(0, total - free - cache)
    zram = 0
    for d in os.listdir("/sys/block"):
        if d.startswith("zram"):
            f = read(f"/sys/block/{d}/mm_stat").split()
            if len(f) > 2:
                zram += int(f[2])
    return {"total": total, "used": used, "cache": cache, "zram": zram, "free": free,
            "swap": m.get("SwapTotal", 0) - m.get("SwapFree", 0)}


# ----------------------------------------------------------------- gpu

def gpu():
    """The first GPU that reports its load (amdgpu): load, memory, sensors."""
    root = "/sys/class/drm"
    for card in sorted(os.listdir(root)):
        d = f"{root}/{card}/device"
        busy = read(f"{d}/gpu_busy_percent").strip()
        if not busy or "-" in card:
            continue
        out = {"busy": int(busy) / 100}
        for key, name in (("vramUsed", "mem_info_vram_used"), ("vramTotal", "mem_info_vram_total"),
                          ("gttUsed", "mem_info_gtt_used"), ("gttTotal", "mem_info_gtt_total")):
            v = read(f"{d}/{name}").strip()
            if v:
                out[key] = int(v)
        try:
            hw = f"{d}/hwmon/" + os.listdir(f"{d}/hwmon")[0]
            t = read(f"{hw}/temp1_input").strip()
            pw = read(f"{hw}/power1_average").strip() or read(f"{hw}/power1_input").strip()
            fq = read(f"{hw}/freq1_input").strip()
            if t:
                out["temp"] = round(int(t) / 1000)
            if pw:
                out["watts"] = round(int(pw) / 1e6, 1)
            if fq:
                out["mhz"] = round(int(fq) / 1e6)
        except OSError:
            pass
        return out
    return {}


# ----------------------------------------------------------------- net

class Net:
    def __init__(self):
        self.prev = None
        self.wifi = {}
        self.wifi_at = 0

    def iface(self):
        for line in read("/proc/net/route").splitlines()[1:]:
            f = line.split()
            if len(f) > 2 and f[1] == "00000000":
                return f[0]
        return None

    def sample(self, now):
        name = self.iface()
        out = {"iface": name}
        counters = {}
        for line in read("/proc/net/dev").splitlines()[2:]:
            n, _, rest = line.partition(":")
            f = rest.split()
            counters[n.strip()] = (int(f[0]), int(f[8]))
        if name and name in counters:
            rx, tx = counters[name]
            if self.prev and self.prev[0] == name:
                dt = max(0.001, now - self.prev[3])
                out["down"] = max(0, (rx - self.prev[1]) / dt)
                out["up"] = max(0, (tx - self.prev[2]) / dt)
            self.prev = (name, rx, tx, now)
        if now - self.wifi_at > 30:
            self.wifi_at = now
            self.wifi = {}
            try:
                r = subprocess.run(["nmcli", "-t", "-f", "ACTIVE,SSID,FREQ", "dev", "wifi"],
                                   capture_output=True, text=True, timeout=3)
                for line in r.stdout.splitlines():
                    if line.startswith("yes:"):
                        parts = line.split(":")
                        self.wifi = {"ssid": ":".join(parts[1:-1]), "mhz": int(re.sub(r"\D", "", parts[-1]) or 0)}
                        break
            except (OSError, subprocess.SubprocessError, ValueError):
                pass
        out.update(self.wifi)
        return out


# ------------------------------------------------------------- battery

def battery():
    root = "/sys/class/power_supply"
    out = {}
    for d in sorted(os.listdir(root)):
        if read(f"{root}/{d}/type").strip() != "Battery" or read(f"{root}/{d}/scope").strip() == "Device":
            continue
        p = f"{root}/{d}"
        cap = read(f"{p}/capacity").strip()
        status = read(f"{p}/status").strip()
        power = read(f"{p}/power_now").strip()
        if power:
            watts = int(power) / 1e6
        else:
            cur, volt = read(f"{p}/current_now").strip(), read(f"{p}/voltage_now").strip()
            watts = int(cur) * int(volt) / 1e12 if cur and volt else 0
        energy = read(f"{p}/energy_now").strip()
        full = read(f"{p}/energy_full").strip()
        left = None
        if energy and watts > 0.3:
            e = int(energy) / 1e6
            if status == "Discharging":
                left = e / watts * 3600
            elif status == "Charging" and full:
                left = (int(full) / 1e6 - e) / watts * 3600
        out = {"name": d, "pct": int(cap) if cap else None, "status": status, "watts": round(watts, 2),
               "left": round(left) if left else None,
               "ac": any(read(f"{root}/{a}/online").strip() == "1" for a in os.listdir(root)
                         if read(f"{root}/{a}/type").strip() == "Mains")}
        break
    return out


def battery_day(name):
    """The last 24 h from UPower's own history: [[t, pct], ...] and [[t, watts], ...]."""
    out = {}
    path = "/org/freedesktop/UPower/devices/battery_" + name
    for kind in ("charge", "rate"):
        try:
            r = subprocess.run(["busctl", "--system", "--json=short", "call", "org.freedesktop.UPower", path,
                                "org.freedesktop.UPower.Device", "GetHistory", "suu", kind, "86400", "200"],
                               capture_output=True, text=True, timeout=4)
            rows = json.loads(r.stdout)["data"][0]
            out[kind] = sorted([[int(t), round(float(v), 2)] for t, v, _ in rows])
        except (OSError, subprocess.SubprocessError, ValueError, KeyError, IndexError, TypeError):
            pass
    return out


# ----------------------------------------------------------- processes

GROUPS = [
    (re.compile(r"^(brave|brave-browser|brave-origin)"), "Brave"),
    (re.compile(r"^(chrome|chromium)"), "Chromium"),
    (re.compile(r"^(firefox|Web Content|WebExtensions|Isolated Web|Socket Process|Privileged Cont|RDD Process|Utility Process)"), "Firefox"),
    (re.compile(r"^claude"), "Claude"),
    (re.compile(r"^(Hyprland|hyprland|quickshell|qs|omarchy-shell|owed|Xwayland)"), "Hyprland + shell"),
    (re.compile(r"^(obsidian|Obsidian)"), "Obsidian"),
    (re.compile(r"^(lemond|flm)"), "lemond (NPU)"),
    (re.compile(r"^(pipewire|wireplumber|pipewire-pulse)"), "PipeWire"),
    (re.compile(r"^(node|npm|bun|deno)"), "Node"),
    (re.compile(r"^(python|python3)"), "Python"),
]


# What the HUD's X on a group does: restart the shell (never kill the
# compositor), restart the systemd services the group runs as, or end its
# processes (SIGTERM). Nothing for system processes or other users'.
NEVER = {"systemd", "(sd-pam)", "dbus-daemon", "dbus-broker", "dbus-broker-lau", "login", "agetty", "sshd"}
UID = os.getuid()


def unit_of(pid):
    """The systemd unit a process runs in (user manager only), or None."""
    for line in read(f"/proc/{pid}/cgroup").splitlines():
        path = line.split("::", 1)[-1]
        if f"/user@{UID}.service/" not in path:
            return None
        last = path.rsplit("/", 1)[-1]
        return last if last.endswith((".service", ".scope")) else None
    return None


def owner(pid):
    for line in read(f"/proc/{pid}/status").splitlines():
        if line.startswith("Uid:"):
            return int(line.split()[1])
    return -1


def action_of(name, roots, comms):
    if name == "Hyprland + shell":
        return {"kind": "shell"}
    if comms & NEVER or not roots:
        return None
    if any(owner(p) != UID for p in roots):
        return None
    units = {unit_of(p) for p in roots}
    if None in units:
        return None
    services = sorted(u for u in units if u.endswith(".service") and not u.startswith("app-")
                      and not u.startswith("wayland-wm@"))
    if services and len(services) == len(units):
        return {"kind": "restart", "units": services}
    if any(u.startswith("wayland-wm@") for u in units):
        return None
    return {"kind": "kill", "pids": [int(p) for p in roots][:64]}


def group_of(comm):
    for rx, name in GROUPS:
        if rx.match(comm):
            return name
    return comm


class Procs:
    def __init__(self):
        self.prev = {}
        self.prev_t = None

    def sample(self, now):
        cur = {}
        info = {}
        for pid in os.listdir("/proc"):
            if not pid.isdigit():
                continue
            s = read(f"/proc/{pid}/stat")
            if not s:
                continue
            r = s.rfind(")")
            comm = s[s.find("(") + 1:r]
            f = s[r + 2:].split()
            if f[1] == "2" or pid == "2":  # kernel threads
                continue
            ticks = int(f[11]) + int(f[12])
            rss = int(f[21]) * PAGE
            cur[pid] = ticks
            info[pid] = (comm, f[1], rss)
        out = None
        if self.prev_t is not None:
            dt = max(0.001, now - self.prev_t)
            ncpu = os.cpu_count() or 1
            groups = {}
            for pid, ticks in cur.items():
                comm, ppid, rss = info[pid]
                g = group_of(comm)
                d = ticks - self.prev.get(pid, ticks)
                e = groups.setdefault(g, {"name": g, "cpu": 0.0, "rss": 0, "count": 0, "_roots": [], "_comms": set()})
                e["cpu"] += d / CLK / dt / ncpu
                e["rss"] += rss
                e["_comms"].add(comm)
                parent = info.get(ppid)
                if not parent or group_of(parent[0]) != g:
                    e["count"] += 1
                    e["_roots"].append(pid)
            top = sorted(groups.values(), key=lambda e: (e["cpu"], e["rss"]), reverse=True)[:6]
            for e in groups.values():
                roots, comms = e.pop("_roots"), e.pop("_comms")
                if e in top:
                    e["action"] = action_of(e["name"], roots, comms)
            for e in top:
                e["cpu"] = round(e["cpu"], 3)
            out = top
        self.prev, self.prev_t = cur, now
        return out


# ----------------------------------------------------------------- npu

def http_json(url, timeout=0.6):
    with urllib.request.urlopen(url, timeout=timeout) as r:
        return json.loads(r.read(200000))


LAST_MODEL = os.path.expanduser("~/.local/state/hudwall/npu-last-model")


def npu():
    out = {}
    try:
        h = http_json("http://127.0.0.1:13305/api/v1/health")
        models = h.get("all_models_loaded") or []
        m = next((x for x in models if x.get("device") == "npu"), None)
        # No model on the NPU: Lemonade is up but nothing can answer there.
        out["loaded"] = m is not None
        if m:
            out["model"] = m.get("model_name") or m.get("checkpoint")
            out["busy"] = bool(m.get("is_busy") or m.get("is_streaming"))
            # Kept on disk, to name the model once it is unloaded.
            if read(LAST_MODEL).strip() != out["model"]:
                try:
                    os.makedirs(os.path.dirname(LAST_MODEL), exist_ok=True)
                    with open(LAST_MODEL, "w") as f:
                        f.write(out["model"] + "\n")
                except OSError:
                    pass
        else:
            out["lastModel"] = read(LAST_MODEL).strip() or None
        out["up"] = True
    except Exception:
        return {"up": False}
    try:
        s = http_json("http://127.0.0.1:13305/api/v1/stats")
        out["tps"] = s.get("tokens_per_second")
        out["requests"] = s.get("request_count_total")
        out["outTokens"] = s.get("output_tokens_total")
    except Exception:
        pass
    try:
        q = http_json("http://127.0.0.1:13306/queue")
        out["running"] = q.get("running") is not None
        out["waiting"] = len(q.get("waiting") or [])
    except Exception:
        pass
    return out


def npu_day():
    """The last 24 h of the NPU, hour by hour, from the npu-queue journal (it
    logs each request: `done: <client> <priority> ran 9.2s`), so the history
    survives shell restarts: busy seconds per client in each hour."""
    now = time.time()
    t0 = (int(now) // 3600 - 23) * 3600
    hours = [{} for _ in range(24)]
    count = 0
    try:
        r = subprocess.run(["journalctl", "--user", "-u", "npu-queue", "--since", f"@{t0}",
                            "-o", "short-unix", "--no-pager", "-q"],
                           capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return None
    for line in r.stdout.splitlines():
        m = re.match(r"^(\d+(?:\.\d+)?) \S+ \S+ done: (\S+) \S+ ran ([\d.]+)s", line)
        if not m:
            continue
        end, client, ran = float(m.group(1)), m.group(2), float(m.group(3))
        # Spread the run over the hours it covered.
        start = end - ran
        while ran > 0 and start < end:
            h = int((start - t0) // 3600)
            cut = min(end, t0 + (h + 1) * 3600)
            if 0 <= h < 24:
                hours[h][client] = round(hours[h].get(client, 0) + (cut - start), 1)
            start = cut
        count += 1
    return {"t0": t0, "hours": hours, "requests": count}


# ------------------------------------------------------- network peers

class Geo:
    PATHS = ["dbip-city-ipv4.mmdb", "dbip-city-lite.mmdb", "GeoLite2-City.mmdb"]

    def __init__(self):
        self.reader = None
        self.cache = {}
        for name in self.PATHS:
            p = os.path.join(DATA, name)
            if os.path.exists(p):
                try:
                    import mmdb
                    self.reader = mmdb.Reader(p)
                    break
                except Exception as e:
                    print(f"hudwall-collector: {p}: {e}", file=sys.stderr)

    def locate(self, ip):
        if not self.reader:
            return None
        if ip in self.cache:
            return self.cache[ip]
        loc = None
        try:
            r = self.reader.get(ip) or {}
            if "latitude" in r:
                # ip-location-db layout: flat fields.
                city, country, lat, lon = r.get("city"), r.get("country_code"), r["latitude"], r["longitude"]
            else:
                # MaxMind / DB-IP layout: nested records.
                l = r.get("location") or {}
                lat, lon = l.get("latitude"), l.get("longitude")
                city = ((r.get("city") or {}).get("names") or {}).get("en")
                country = (r.get("country") or {}).get("iso_code")
            if lat is not None and lon is not None:
                if isinstance(city, str):
                    city = city.split(" (")[0]
                loc = {"lat": lat, "lon": lon, "city": city, "country": country}
        except Exception:
            pass
        if len(self.cache) > 2000:
            self.cache.clear()
        self.cache[ip] = loc
        return loc


def public(ip):
    try:
        a = ipaddress.ip_address(ip)
    except ValueError:
        return False
    if a.version == 6 and a.ipv4_mapped:
        a = a.ipv4_mapped
    if a.is_private or a.is_loopback or a.is_link_local or a.is_multicast or a.is_reserved or a.is_unspecified:
        return False
    if a.version == 4 and a in ipaddress.ip_network("100.64.0.0/10"):
        return False
    return True


class Peers:
    """The last ten public peers this machine opened a TCP connection to,
    with the bytes exchanged with each (sent + received, added up from the
    sockets' counters between samples)."""

    PATH = os.path.join(STATE, "peers.json")

    def __init__(self):
        self.geo = Geo()
        self.seen = []  # newest first: {ip, port, proc, first, last, bytes, ...geo}
        self.sockets = {}  # "local peer" -> bytes counted so far
        # The list outlives the collector, which only runs while the HUD shows.
        try:
            with open(self.PATH) as f:
                self.seen = [p for p in json.load(f) if isinstance(p, dict) and "ip" in p][:10]
            for p in self.seen:
                p["live"] = False
                if "lat" not in p:
                    loc = self.geo.locate(p["ip"])
                    if loc:
                        p.update(loc)
        except (OSError, ValueError):
            pass

    def save(self):
        try:
            os.makedirs(STATE, exist_ok=True)
            tmp = self.PATH + ".tmp"
            with open(tmp, "w") as f:
                json.dump(self.seen, f)
            os.replace(tmp, self.PATH)
        except OSError:
            pass

    def sample(self, now):
        try:
            r = subprocess.run(["ss", "-tinpH", "state", "established"], capture_output=True, text=True, timeout=3)
        except (OSError, subprocess.SubprocessError):
            return None
        live = {}
        moved = {}       # ip -> bytes since the last sample
        sockets = {}
        lines = r.stdout.splitlines()
        for n, line in enumerate(lines):
            if line[:1].isspace():
                continue
            f = line.split()
            if len(f) < 4:
                continue
            info = lines[n + 1] if n + 1 < len(lines) and lines[n + 1][:1].isspace() else ""
            total = 0
            for key in ("bytes_sent", "bytes_received"):
                m = re.search(key + r":(\d+)", info)
                if m:
                    total += int(m.group(1))
            sock = f[2] + " " + f[3]
            sockets[sock] = total
            peer = f[3]
            ip, _, port = peer.rpartition(":")
            ip = ip.strip("[]")
            if "%" in ip:
                ip = ip.split("%")[0]
            if not public(ip):
                continue
            m = re.search(r'users:\(\("([^"]+)"', line)
            live.setdefault(ip, (port, m.group(1) if m else ""))
            moved[ip] = moved.get(ip, 0) + max(0, total - self.sockets.get(sock, 0))
        self.sockets = sockets
        index = {p["ip"]: p for p in self.seen}
        changed = False
        for ip, (port, proc) in live.items():
            if ip in index:
                index[ip]["last"] = now
                index[ip]["live"] = True
                if moved.get(ip):
                    index[ip]["bytes"] = index[ip].get("bytes", 0) + moved[ip]
                    changed = True
                continue
            entry = {"ip": ip, "port": int(port) if port.isdigit() else 0, "proc": group_of(proc) if proc else "",
                     "first": now, "last": now, "live": True, "bytes": moved.get(ip, 0)}
            loc = self.geo.locate(ip)
            if loc:
                entry.update(loc)
            self.seen.insert(0, entry)
            changed = True
        for p in self.seen:
            if p["ip"] not in live:
                p["live"] = False
        self.seen = self.seen[:10]
        if changed:
            self.save()
        return {"geo": self.geo.reader is not None, "list": self.seen}


class Tailnet:
    def __init__(self):
        self.lat = {}

    def sample(self, cfg):
        try:
            r = subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True, timeout=4)
            d = json.loads(r.stdout)
        except (OSError, subprocess.SubprocessError, ValueError):
            return {"up": False}
        peers = []
        for p in (d.get("Peer") or {}).values():
            ips = p.get("TailscaleIPs") or []
            peers.append({"name": p.get("HostName") or p.get("DNSName", "").split(".")[0], "online": bool(p.get("Online")),
                          "direct": bool(p.get("CurAddr")), "relay": p.get("Relay") or "", "ip": ips[0] if ips else ""})
        want = cfg.get("pingPeers")
        if not isinstance(want, list):
            want = [p["name"] for p in peers if p["online"]][:3]
        for p in peers:
            if p["name"] in want and p["online"] and p["ip"]:
                try:
                    r = subprocess.run(["ping", "-c1", "-W1", "-q", p["ip"]], capture_output=True, text=True, timeout=3)
                    m = re.search(r"= [\d.]+/([\d.]+)/", r.stdout)
                    p["ms"] = round(float(m.group(1))) if m else None
                except (OSError, subprocess.SubprocessError):
                    p["ms"] = None
        peers.sort(key=lambda p: (p["name"] not in want, not p["online"], p["name"]))
        return {"up": d.get("BackendState") == "Running", "relay": (d.get("Self") or {}).get("Relay", ""), "peers": peers[:6]}


# --------------------------------------------------------------- uptime

class Uptime:
    """The services listed under `uptime` in the config, as a watcher running
    elsewhere sees them: the HUD does not check anything itself (one copy of
    the checks, on the watcher), it reads `uptimeSource`, a URL answering
    { "targets": [{ "name", "state", "since", "ms", "code", "cert", "err",
    "checked", "hist": [[time, ms or null, "u"|"s"|"d"], ...] }] }, every 15 s
    from a thread of its own.

    The config's list gives the order, and what each beacon shows and opens
    ("name", "note", "open"; "url" or "tcp" as its target). A service the
    watcher does not keep is "wait"; with `"watcher": true`, the beacon is the
    watcher itself: up while it answers (its answer time as latency). While the
    watcher cannot be read, every beacon is "nowatch" (grey): nothing is known.
    """
    EVERY = 15

    def __init__(self):
        import threading
        self.lock = threading.Lock()
        self.targets = []
        self.source = ""
        self.remote = None       # name -> state; None while the watcher cannot be read
        self.ms = None           # the watcher's answer time
        self.checked = None
        self.version = 0
        self.wake = threading.Event()
        threading.Thread(target=self.run, daemon=True).start()

    def configure(self, cfg):
        raw = cfg.get("uptime")
        targets = [t for t in (raw if isinstance(raw, list) else []) if isinstance(t, dict) and t.get("name")]
        source = cfg.get("uptimeSource") if isinstance(cfg.get("uptimeSource"), str) else ""
        with self.lock:
            if targets != self.targets or source != self.source:
                self.targets, self.source = targets, source
                self.version += 1        # the HUD gets the new list at once
                self.wake.set()

    def fetch(self):
        t = time.time()
        try:
            with urllib.request.urlopen(self.source, timeout=5) as r:
                d = json.load(r)
            remote = {x["name"]: x for x in d.get("targets", []) if isinstance(x, dict) and x.get("name")}
            return remote, round((time.time() - t) * 1000)
        except (OSError, ValueError, KeyError, TypeError, AttributeError):
            return None, None

    def run(self):
        while True:
            if self.source:
                remote, ms = self.fetch()
                with self.lock:
                    if remote != self.remote or (self.remote is None) != (remote is None):
                        self.version += 1
                    self.remote, self.ms, self.checked = remote, ms, round(time.time())
            self.wake.wait(self.EVERY)
            self.wake.clear()

    def sample(self, seen=None):
        """(version, services), or (version, None) when nothing changed since `seen`."""
        with self.lock:
            if self.version == seen:
                return seen, None
            out = []
            for t in self.targets:
                if self.remote is None:
                    s = {"state": "nowatch", "err": "the watcher cannot be read" if self.source else "no uptimeSource in the config"}
                elif t.get("watcher"):
                    s = {"state": "up", "ms": self.ms, "checked": self.checked}
                else:
                    s = self.remote.get(t["name"]) or {"state": "wait", "err": "not kept by the watcher"}
                out.append({"name": t["name"], "target": t.get("url") or t.get("tcp") or "", "note": t.get("note", ""),
                            "open": t.get("open", t.get("url", "")),
                            "via": "watcher" if t.get("watcher") else "remote",
                            **{k: s.get(k) for k in ("state", "since", "ms", "code", "cert", "err", "checked")},
                            "hist": s.get("hist") or []})
            return self.version, out


# ---------------------------------------------------------------- main

def models():
    """The CPU's and GPU's names, short: "Ryzen AI 5 340", "Radeon 840M".
    An APU names its GPU in the CPU's name ("... w/ Radeon 840M"), more
    precisely than the PCI database; otherwise lspci's bracketed name."""
    cpu = ""
    for line in read("/proc/cpuinfo").splitlines():
        if line.startswith("model name"):
            cpu = line.split(":", 1)[1].strip()
            break
    gpu = ""
    if " w/ " in cpu:
        cpu, gpu = cpu.split(" w/ ", 1)
    else:
        try:
            r = subprocess.run(["lspci", "-mm"], capture_output=True, text=True, timeout=3)
            for line in r.stdout.splitlines():
                if re.search(r'"(VGA|Display|3D)', line):
                    name = re.findall(r'"([^"]*)"', line)[2]
                    m = re.search(r"\[([^\]]+)\]", name)
                    gpu = m.group(1) if m else name
                    break
        except (OSError, subprocess.SubprocessError, IndexError):
            pass
    strip = lambda s: re.sub(r"^(AMD|Intel\(R\)|Intel|NVIDIA)\s+", "", re.sub(r"\s+(Processor|\d+-Core.*)$", "", s)).strip()
    return {"cpu": strip(cpu), "gpu": strip(gpu)}


def emit(obj):
    sys.stdout.write(json.dumps(obj, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def main():
    cpu, net, procs, peers, tail = Cpu(), Net(), Procs(), Peers(), Tailnet()
    cfg = config()
    uptime = Uptime()
    uptime.configure(cfg)
    uptime_sent = -1
    tick = 0
    bat_name = None
    npu_served, npu_dirty, npu_read = None, False, 0.0
    while True:
        now = time.time()
        out = {"t": round(now, 3), "cpu": cpu.sample(), "gpu": gpu(), "mem": memory(), "net": net.sample(now)}
        if tick % 5 == 0:
            out["bat"] = battery()
            bat_name = out["bat"].get("name") or bat_name
        if tick % 3 == 0:
            p = procs.sample(now)
            if p is not None:
                out["procs"] = p
        if tick % 2 == 0:
            out["npu"] = npu()
            served = out["npu"].get("requests")
            if served is not None and served != npu_served:
                npu_dirty, npu_served = True, served
        if tick % 5 == 0:
            p = peers.sample(now)
            if p is not None:
                out["peers"] = p
        if tick % 30 == 0:
            cfg = config()
            uptime.configure(cfg)
            up = read("/proc/uptime").split()
            out["host"] = {"name": os.uname().nodename, "kernel": os.uname().release,
                           "uptime": int(float(up[0])) if up else 0, **models()}
            out["tail"] = tail.sample(cfg)
        if tick % 600 == 0 or (npu_dirty and now - npu_read >= 60):
            d = npu_day()
            npu_read, npu_dirty = now, False
            if d is not None:
                out["npuDay"] = d
        uptime_sent, targets = uptime.sample(uptime_sent)
        if targets is not None:
            out["uptime"] = targets
        if tick % 300 == 0 and bat_name:
            out["batDay"] = battery_day(bat_name)
        emit(out)
        tick += 1
        time.sleep(max(0.05, 1 - (time.time() - now)))


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, BrokenPipeError):
        pass
