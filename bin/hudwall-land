#!/usr/bin/env python3
"""Turns a world-atlas land TopoJSON into the globe's land mask.

hudwall-land <land-110m.json> <out.png>

An equirectangular 1440 x 720 grayscale PNG: white on land, black at sea.
The globe's shader reads it to place its dots.
"""

import json
import sys


def decode_arcs(topo):
    tr = topo.get("transform")
    arcs = []
    for arc in topo["arcs"]:
        x = y = 0
        pts = []
        for p in arc:
            if tr:
                x += p[0]
                y += p[1]
                pts.append((x * tr["scale"][0] + tr["translate"][0], y * tr["scale"][1] + tr["translate"][1]))
            else:
                pts.append((p[0], p[1]))
        arcs.append(pts)
    return arcs


def ring(arcs, idx):
    out = []
    for i in idx:
        a = arcs[i] if i >= 0 else list(reversed(arcs[~i]))
        out.extend(a if not out else a[1:])
    return out


def polygons(topo):
    arcs = decode_arcs(topo)
    obj = topo["objects"]["land"]
    geoms = obj["geometries"] if obj["type"] == "GeometryCollection" else [obj]
    for g in geoms:
        if g["type"] == "Polygon":
            yield [ring(arcs, r) for r in g["arcs"]]
        elif g["type"] == "MultiPolygon":
            for p in g["arcs"]:
                yield [ring(arcs, r) for r in p]


def png_gray(path, w, h, rows):
    """Writes an 8-bit grayscale PNG, stdlib only."""
    import struct
    import zlib

    def chunk(kind, data):
        c = struct.pack(">I", len(data)) + kind + data
        return c + struct.pack(">I", zlib.crc32(kind + data) & 0xFFFFFFFF)

    raw = b"".join(b"\x00" + bytes(r) for r in rows)
    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n")
        f.write(chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 0, 0, 0, 0)))
        f.write(chunk(b"IDAT", zlib.compress(raw, 9)))
        f.write(chunk(b"IEND", b""))


def main():
    topo = json.load(open(sys.argv[1]))
    w, h = 1440, 720
    rows = [bytearray(w) for _ in range(h)]
    # Scanline fill, even-odd over every ring of a polygon (holes are lakes).
    for poly in polygons(topo):
        edges = []
        for ring_pts in poly:
            n = len(ring_pts)
            for i in range(n):
                x0, y0 = ring_pts[i]
                x1, y1 = ring_pts[(i + 1) % n]
                if abs(x1 - x0) > 180:  # an antimeridian jump: skip the edge
                    continue
                edges.append((x0, y0, x1, y1))
        ys = [y for e in edges for y in (e[1], e[3])]
        if not ys:
            continue
        r0 = max(0, int((90 - max(ys)) / 180 * h))
        r1 = min(h - 1, int((90 - min(ys)) / 180 * h) + 1)
        for row in range(r0, r1 + 1):
            lat = 90 - (row + 0.5) * 180 / h
            xs = []
            for x0, y0, x1, y1 in edges:
                if (y0 > lat) != (y1 > lat):
                    xs.append(x0 + (lat - y0) * (x1 - x0) / (y1 - y0))
            xs.sort()
            line = rows[row]
            for a, b in zip(xs[0::2], xs[1::2]):
                c0 = max(0, int((a + 180) / 360 * w))
                c1 = min(w - 1, int((b + 180) / 360 * w))
                for c in range(c0, c1 + 1):
                    line[c] = 255 - line[c]  # even-odd across rings
    png_gray(sys.argv[2], w, h, rows)
    print(f"land mask {w}x{h} -> {sys.argv[2]}")


if __name__ == "__main__":
    main()
